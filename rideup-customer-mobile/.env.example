# Copy file này thành .env (cùng thư mục) rồi sửa.
# IP LAN của máy chạy backend — xem bằng lệnh `ipconfig` (IPv4 Address của Wi-Fi). Chạy trên web thì không cần.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080/api

# Stripe publishable key (Test mode) — Stripe Dashboard > Developers > API keys. Phải cùng tài khoản với secret-key của backend.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
